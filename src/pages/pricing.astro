---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, plans, pricingNote } from '../data/site';

const title = `Pricing — ${site.name}`;
const description =
  'Simple, transparent pricing for your gym’s own branded app: a one-off setup fee, a monthly club subscription, and a small per-member fee. All functionality included on every plan.';

const siteUrl = Astro.site?.href ?? 'https://harbourfitness.co.uk';
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${site.name} — branded club app`,
  description,
  brand: { '@type': 'Brand', name: site.name },
  offers: plans.map((p) => ({
    '@type': 'Offer',
    name: `${p.name} plan`,
    priceCurrency: 'GBP',
    price: p.club.replace(/[£,]/g, ''),
    description: `${p.members}. ${p.club}/month club fee, ${p.perMember}/month per member, ${p.setup} one-off setup. All functionality included.`,
    url: new URL('/pricing/', siteUrl).href,
    availability: 'https://schema.org/InStock',
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Pricing', item: new URL('/pricing/', siteUrl).href },
  ],
};

const included = [
  'Your own branded iOS & Android app',
  'Class & session management',
  'Reusable exercise library',
  'Mobile-first workout logging',
  'Member roster & admin',
  'Progress tracking & reports',
];
---

<Base title={title} description={description}>
  <!-- Header -->
  <section class="border-b border-ink-200">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
      <p class="text-sm font-medium uppercase tracking-wider text-teal-700">Pricing</p>
      <h1 class="display mt-3 text-4xl md:text-5xl text-brand-950 max-w-3xl">
        One simple structure. All the functionality.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-600 leading-relaxed">
        Every plan includes the complete platform — the only thing that changes is the size of
        your club. A one-off setup fee gets your branded app built and published; after that it’s a
        monthly club subscription plus a small per-member fee.
      </p>
    </div>
  </section>

  <!-- Plans -->
  <section class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid gap-6 lg:grid-cols-3 items-start">
      {plans.map((p) => (
        <div class={`relative flex flex-col rounded-2xl border bg-white p-7 ${p.highlight ? 'border-brand-600 ring-1 ring-brand-600 shadow-xl' : 'border-ink-200'}`}>
          {p.highlight && (
            <span class="absolute -top-3 left-7 rounded-full bg-accent-500 px-3 py-1 text-xs font-semibold text-brand-950">
              Most popular
            </span>
          )}
          <h2 class="text-xl font-semibold text-ink-900">{p.name}</h2>
          <p class="mt-1 text-sm font-medium text-teal-700">{p.members}</p>
          <p class="mt-3 text-ink-600 leading-relaxed">{p.blurb}</p>

          <div class="mt-6 border-t border-ink-100 pt-6">
            <div class="flex items-baseline gap-1">
              <span class="text-3xl font-bold text-ink-900">{p.club}</span>
              <span class="text-ink-500">/ month club fee</span>
            </div>
            <p class="mt-2 text-ink-700">
              <span class="text-xl font-semibold text-ink-900">{p.perMember}</span>
              <span class="text-ink-500"> / month per member</span>
            </p>
            <p class="mt-3 text-sm text-ink-500">
              <span class="font-medium text-ink-700">{p.setup}</span> one-off setup fee
            </p>
          </div>

          <div class="mt-6 flex items-center gap-2 rounded-lg bg-brand-50 px-3 py-2 text-sm font-medium text-brand-700">
            <Icon name="sparkles" class="h-4 w-4" />
            All functionality included
          </div>

          <a
            href="/contact/"
            class={`mt-6 inline-flex justify-center rounded-xl px-5 py-3 font-medium transition-colors ${p.highlight ? 'bg-brand-700 text-white hover:bg-brand-800' : 'border border-ink-300 text-ink-800 hover:border-brand-400 hover:text-brand-700'}`}
          >
            Book a demo
          </a>
        </div>
      ))}
    </div>

    <p class="mt-6 text-sm text-ink-500">All prices exclude VAT. Cancel your monthly subscription any time.</p>
  </section>

  <!-- What's included -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16">
      <p class="text-sm font-medium uppercase tracking-wider text-teal-700">Every plan includes</p>
      <h2 class="display mt-3 text-2xl md:text-3xl text-brand-950">The whole platform. No tiers on features.</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {included.map((f) => (
          <li class="flex items-start gap-3 text-ink-700">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-teal-600 text-white">
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bespoke -->
  <section class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16">
    <div class="rounded-3xl border border-ink-200 bg-white p-8 md:p-12">
      <div class="grid gap-6 md:grid-cols-3 md:items-center">
        <div class="md:col-span-2">
          <p class="text-sm font-medium uppercase tracking-wider text-brand-600">Need more?</p>
          <h2 class="display mt-3 text-2xl md:text-3xl text-brand-950">Bespoke work, on request.</h2>
          <p class="mt-3 max-w-2xl text-ink-600 leading-relaxed">{pricingNote}</p>
        </div>
        <div class="md:text-right">
          <a href="/contact/" class="inline-flex rounded-xl bg-brand-700 px-5 py-3 font-medium text-white hover:bg-brand-800 transition-colors">
            Talk to us &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(productLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>
