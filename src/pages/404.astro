---
import Base from '../layouts/Base.astro';
const title = 'Page not found - Harbour Fitness';
const description = 'The page you were looking for could not be found.';
---

<Base title={title} description={description} noindex={true}>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-40 -right-32 h-[34rem] w-[34rem] rounded-full bg-accent-200/50 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-48 -left-40 h-[30rem] w-[30rem] rounded-full bg-brand-200/45 blur-3xl"></div>
  <div class="relative mx-auto max-w-2xl px-5 sm:px-6 lg:px-8 py-24 text-center">
    <p class="eyebrow text-accent-700">404</p>
    <h1 class="display mt-3 text-4xl md:text-5xl text-brand-950">This page has gone for a run.</h1>
    <p class="mt-4 text-ink-600 leading-relaxed">
      The page you were looking for isn’t here. Let’s get you back on track.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-xl bg-accent-500 px-5 py-3 font-semibold text-brand-950 hover:bg-accent-400 transition-colors">
        Back to home
      </a>
      <a href="/features/" class="rounded-xl border border-ink-300 bg-white px-5 py-3 font-medium text-ink-800 hover:border-brand-400 hover:text-brand-700 transition-colors">
        See features
      </a>
    </div>
    </div>
  </section>
</Base>
