---
type Props = {
  accent: string;
  eyebrow: string;
  title: string;
  body: string;
  points: string[];
};
const { accent, eyebrow, title, body, points } = Astro.props;
---

<div class="flex flex-col rounded-2xl border border-ink-200 bg-white p-7">
  <span class="h-1.5 w-10 rounded-full" style={`background:${accent}`}></span>
  <p class="mt-5 text-xs font-medium uppercase tracking-wider" style={`color:${accent}`}>{eyebrow}</p>
  <h3 class="mt-2 text-xl font-semibold tracking-tight text-ink-900">{title}</h3>
  <p class="mt-3 text-ink-600 leading-relaxed">{body}</p>
  <ul class="mt-5 space-y-2.5 border-t border-ink-100 pt-5">
    {points.map((p) => (
      <li class="flex items-start gap-2.5 text-sm text-ink-700">
        <span class="mt-1.5 inline-block size-1.5 shrink-0 rounded-full" style={`background:${accent}`}></span>
        <span>{p}</span>
      </li>
    ))}
  </ul>
</div>
