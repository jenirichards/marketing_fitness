---
// Emits BreadcrumbList structured data (Home > <name>) for a sub-page.
type Props = { name: string; path: string };
const { name, path } = Astro.props;
const siteUrl = Astro.site?.href ?? 'https://harbourfitness.co.uk';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name, item: new URL(path, siteUrl).href },
  ],
};
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
