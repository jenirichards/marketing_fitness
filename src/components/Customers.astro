---
import { customers, customerPlaceholders } from '../data/site';
const placeholders = Array.from({ length: customerPlaceholders });
---

<section class="border-t border-ink-200">
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
    <p class="eyebrow text-accent-700">Clubs on Harbour Fitness</p>
    <h2 class="display mt-3 text-3xl md:text-4xl text-brand-950">In good company.</h2>
    <p class="mt-4 max-w-2xl text-ink-600 leading-relaxed">
      Real clubs, each with their own branded app on the stores - running on one platform.
      There’s room here for yours.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {customers.map((c) => {
        const Tag = c.website ? 'a' : 'div';
        return (
          <Tag
            href={c.website}
            {...(c.website ? { target: '_blank', rel: 'noopener' } : {})}
            class="group flex flex-col rounded-2xl border border-ink-200 bg-white p-5 transition-colors hover:border-brand-300"
          >
            <div
              class="flex h-28 items-center justify-center rounded-xl overflow-hidden"
              style={`background:${c.logoBg ?? '#f4f4f5'}`}
            >
              {c.logo ? (
                <img src={c.logo} alt={`${c.name} logo`} class="h-20 w-20 object-contain" loading="lazy" />
              ) : (
                <span class="text-lg font-semibold text-white">{c.name}</span>
              )}
            </div>
            <p class="mt-4 font-semibold text-ink-900">{c.name}</p>
            <p class="mt-0.5 text-sm text-ink-600">{c.descriptor}</p>
            {c.website && (
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-700 group-hover:underline">
                Visit site &rarr;
              </span>
            )}
          </Tag>
        );
      })}

      {placeholders.map(() => (
        <div class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-ink-200 bg-ink-50/60 p-5 text-center">
          <div class="flex h-28 w-full items-center justify-center rounded-xl">
            <img src="/logos/harbourFitnessIcon.svg" alt="" class="h-12 w-12 opacity-25" />
          </div>
          <p class="mt-4 font-semibold text-ink-500">Your gym here</p>
          <a href="/contact/" class="mt-1 text-sm font-medium text-brand-700 hover:underline">Book a demo &rarr;</a>
        </div>
      ))}
    </div>
  </div>
</section>
