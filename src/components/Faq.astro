---
import { faqs } from '../data/site';

// FAQPage structured data - eligible for FAQ rich results in search.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="border-t border-ink-200 bg-ink-50">
  <div class="mx-auto max-w-3xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
    <p class="eyebrow text-accent-700">FAQ</p>
    <h2 class="display mt-3 text-3xl md:text-4xl text-brand-950">Questions, answered.</h2>

    <div class="mt-8 divide-y divide-ink-200 border-y border-ink-200">
      {faqs.map((f) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 list-none">
            <h3 class="text-lg font-semibold text-ink-900">{f.q}</h3>
            <span class="shrink-0 text-brand-600 transition-transform group-open:rotate-45">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <p class="mt-3 text-ink-600 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>
