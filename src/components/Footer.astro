---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-200 bg-ink-50 mt-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-12 grid gap-8 md:grid-cols-4 text-sm text-ink-600">
    <div class="md:col-span-2">
      <img src="/logos/harbourFitnessLogo.svg" alt="Harbour Fitness" class="h-9 w-auto" />
      <p class="mt-4 text-ink-500 max-w-sm leading-relaxed">
        White-labelled club apps for the modern gym. Give your members their own app to log
        and track every session — published under your name, run from one branded portal.
      </p>
      <a href="/contact/" class="mt-4 inline-block text-brand-700 font-medium hover:underline">
        Book a demo &rarr;
      </a>
    </div>
    <div>
      <p class="font-semibold text-ink-900">Product</p>
      <ul class="mt-3 space-y-1.5">
        {nav.map((l) => (
          <li><a href={l.href} class="hover:text-brand-700">{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-semibold text-ink-900">Get in touch</p>
      <ul class="mt-3 space-y-1.5">
        <li><a href={`mailto:${site.email}`} class="hover:text-brand-700">{site.email}</a></li>
        <li><a href="/contact/" class="hover:text-brand-700">Book a demo</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-200">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-4 text-xs text-ink-500">
      &copy; {year} {site.company}. Harbour Fitness is a product of {site.company}
      (trading as {site.studio}).
    </div>
  </div>
</footer>
