---
import { site, nav } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-200 bg-ink-50 mt-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-12 grid gap-8 md:grid-cols-4 text-sm text-ink-600">
    <div class="md:col-span-2">
      <Logo size={34} class="text-xl" />
      <p class="mt-4 text-ink-500 max-w-sm leading-relaxed">
        Websites, apps and club management for gyms and studios. Your own site taking bookings,
        your own apps on both stores under your name, and one portal behind all of it.
      </p>
      <a href="/contact/" class="mt-4 inline-block text-accent-700 font-semibold hover:underline">
        Book a demo &rarr;
      </a>
    </div>
    <div>
      <p class="font-semibold text-ink-900">Product</p>
      <ul class="mt-3 space-y-1.5">
        {nav.map((l) => (
          <li><a href={l.href} class="hover:text-accent-700">{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-semibold text-ink-900">Get in touch</p>
      <ul class="mt-3 space-y-1.5">
        <li><a href={`mailto:${site.email}`} class="hover:text-accent-700">{site.email}</a></li>
        <li><a href="/contact/" class="hover:text-accent-700">Book a demo</a></li>
      </ul>
      <p class="mt-6 font-semibold text-ink-900">From the studio</p>
      <ul class="mt-3 space-y-1.5">
        <li>
          <a href={site.studioUrl} class="hover:text-accent-700">
            {site.studio} &nearr;
          </a>
        </li>
        <li>
          <a href={`${site.studioUrl}/#products`} class="hover:text-accent-700">
            Our other apps &nearr;
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-200">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 sm:px-6 lg:px-8 py-4 text-xs text-ink-500">
      <p>
        &copy; {year} {site.company}. Harbour Fitness is a product of {site.company}
        (trading as <a href={site.studioUrl} class="font-medium text-ink-700 hover:text-accent-700 hover:underline">{site.studio}</a>).
      </p>
      <a href={site.privacyUrl} class="font-medium text-ink-700 hover:text-accent-700 hover:underline">
        Privacy
      </a>
      <a href="#" data-consent-reopen class="font-medium text-ink-700 hover:text-accent-700 hover:underline">
        Cookie preferences
      </a>
    </div>
  </div>
</footer>
