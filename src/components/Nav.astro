---
import { nav } from '../data/site';
import Logo from './Logo.astro';
---

<header class="border-b border-ink-200 bg-white/80 backdrop-blur sticky top-0 z-20">
  <nav class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
    <a href="/" class="block shrink-0" aria-label="Harbour Fitness - home">
      <Logo size={34} class="text-lg md:text-xl" />
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-7 text-sm text-ink-600">
      {nav.map((l) => (
        <li>
          <a href={l.href} class="hover:text-accent-700 transition-colors">{l.label}</a>
        </li>
      ))}
    </ul>

    <!-- Desktop CTA -->
    <a
      href="/contact/"
      class="hidden md:inline-flex items-center gap-1 rounded-lg bg-accent-500 px-4 py-2 text-sm font-semibold text-brand-950 hover:bg-accent-400 transition-colors"
    >
      Book a demo &rarr;
    </a>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      type="button"
      class="md:hidden inline-flex items-center justify-center rounded-lg p-2 text-ink-700 hover:bg-ink-100 hover:text-accent-700 transition-colors"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle menu"
    >
      <svg class="hamburger-icon h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
      <svg class="close-icon h-6 w-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="6" x2="18" y2="18" /><line x1="6" y1="18" x2="18" y2="6" /></svg>
    </button>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-ink-200 bg-white">
    <ul class="mx-auto max-w-6xl px-5 sm:px-6 py-4 flex flex-col gap-1 text-base text-ink-700">
      {nav.map((l) => (
        <li>
          <a href={l.href} data-menu-link class="block py-2 hover:text-accent-700 transition-colors">{l.label}</a>
        </li>
      ))}
      <li class="pt-3">
        <a
          href="/contact/"
          data-menu-link
          class="inline-flex items-center gap-1 rounded-lg bg-accent-500 px-4 py-2 text-sm font-semibold text-brand-950 hover:bg-accent-400 transition-colors"
        >
          Book a demo &rarr;
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const hamburger = button?.querySelector('.hamburger-icon');
  const close = button?.querySelector('.close-icon');

  function setOpen(open: boolean) {
    if (!button || !menu) return;
    menu.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
    hamburger?.classList.toggle('hidden', open);
    close?.classList.toggle('hidden', !open);
  }

  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  menu?.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
