---
import Icon from './Icon.astro';
import type { Feature } from '../data/site';

type Props = { feature: Feature };
const { feature } = Astro.props;
---

<div class="rounded-2xl border border-ink-200 bg-white p-6 transition-colors hover:border-brand-300">
  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
    <Icon name={feature.icon} class="h-5 w-5" />
  </div>
  <h3 class="mt-4 text-lg font-semibold text-ink-900">{feature.title}</h3>
  <p class="mt-2 text-ink-600 leading-relaxed">{feature.body}</p>
</div>
